# LLM Provider Configuration
# Supported providers: openai, groq, openrouter, ollama, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
API_KEY=your_api_key_here
BASE_URL=

# RAG & Chroma Settings
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=3

# Memory Settings
MAX_SHORT_TERM_MESSAGES=8

# Human-In-The-Loop
REQUIRE_RETRIEVAL_APPROVAL=false
